# SimXSphere Environment Configuration Example
# Copy to .env.local to customize for local or cloud deployment
# NEVER commit real credentials or secret keys to source control!

# Active Storage Mode ('local' or 'cloud')
VITE_STORAGE_MODE=local

# AWS Cloud Mode Configuration (Only needed if Cloud Mode is enabled)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_API_GATEWAY_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
